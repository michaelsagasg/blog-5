---
// Dot-grid bullet-journal paper with a rising weekly trend line and small circle "shot"
// markers at each logged entry. Deliberately not blog-1's peptide chain, or the dose-ladder,
// insulated-box or graduated-cylinder motifs used by the other blogs already built tonight.
const weeks: [number, number][] = [
  [40, 320], [95, 300], [150, 270], [205, 250], [260, 210], [315, 180], [370, 130],
];
---
<svg class="hero-art" viewBox="0 0 420 380" aria-hidden="true" focusable="false">
  <defs>
    <pattern id="ha-dots" width="26" height="26" patternUnits="userSpaceOnUse">
      <circle cx="2" cy="2" r="1.4" fill="currentColor" opacity=".18" />
    </pattern>
  </defs>
  <rect x="0" y="0" width="420" height="380" fill="url(#ha-dots)" />
  <polyline points={weeks.map(([x, y]) => `${x},${y}`).join(' ')} class="ha-trend" fill="none" />
  {weeks.map(([x, y], i) => (
    <g>
      <circle cx={x} cy={y} r="8" class="ha-shot" />
      {i % 2 === 0 && <text x={x} y={y - 16} text-anchor="middle" class="ha-label">wk {i + 1}</text>}
    </g>
  ))}
</svg>
