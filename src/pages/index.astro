---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import HeroArt from '../components/HeroArt.astro';
import { site, getPosts, countBy, catLabel, catTone, catSymbol, withBase, bannerHref, orgJsonLd } from '../lib/site';
const posts = await getPosts();
const cats = countBy(posts, (p) => p.data.category);
const b = site.banner;
---
<Base title={site.name} description={site.tagline || undefined} jsonLd={orgJsonLd(Astro.site!)}>
  <section class="hero">
    <div class="wrap hero-in">
      <div class="notecard">
        <p class="dateline">Updated {posts[0] ? posts[0].data.date.toLocaleDateString('en-GB', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' }) : ''}</p>
        <h1>A weekly shot and weigh-in log for retatrutide and tirzepatide</h1>
        <p class="hero-sub">Injection site rotation, what to note each week, and the questions UK readers ask before their first dose.</p>
        <div class="hero-cta">
          {b.enabled && <a class="btn-shop" href={bannerHref(b.url)} rel="sponsored noopener">{b.button} <span aria-hidden="true">→</span></a>}
          <a class="btn-ghost" href="#all">Browse the guides</a>
        </div>
      </div>
      <HeroArt />
    </div>
  </section>

  <section class="wrap markers" aria-labelledby="topics">
    <h2 id="topics" class="sec-title">This week's page, by topic</h2>
    <div class="marker-row">
      {cats.map(([c, n]) => (
        <a class="marker" href={withBase(`/category/${c}/`)}>
          <span class={`marker-dot t-${catTone(c)}`}>{catSymbol(c)}</span>
          <span class="marker-label">{catLabel(c)}</span>
          <span class="marker-count">{n} guides</span>
        </a>
      ))}
    </div>
  </section>

  {b.enabled && (
    <section class="shopband" aria-label="Shop">
      <a class="sticky" href={bannerHref(b.url)} rel="sponsored noopener">
        <h2>{b.headline}</h2>
        <span class="btn-dark">{b.button} <span aria-hidden="true">→</span></span>
      </a>
    </section>
  )}

  <section class="wrap library" data-filter-root data-limit="12" aria-labelledby="all">
    <div class="lib-head">
      <h2 id="all" class="sec-title">The log so far</h2>
      <form class="search" role="search" onsubmit="return false">
        <input type="search" data-search placeholder="Search, for example injection sites or week 4" aria-label="Search articles" autocomplete="off" />
      </form>
    </div>
    <ul class="filters" aria-label="Filter by topic">
      <li><button type="button" data-chip="all" aria-pressed="true">All <span>{posts.length}</span></button></li>
      {cats.map(([cat, n]) => <li><button class={`t-${catTone(cat)}`} type="button" data-chip={cat} aria-pressed="false"><b>{catSymbol(cat)}</b>{catLabel(cat)} <span>{n}</span></button></li>)}
    </ul>
    <ol class="list timeline">{posts.map((p) => <PostCard post={p} level={3} />)}</ol>
    <p class="empty" data-empty hidden>No articles match that search. Try a different word.</p>
    <div class="more"><button class="btn" type="button" data-more hidden>Show <span>more</span> more articles</button></div>
  </section>
</Base>
